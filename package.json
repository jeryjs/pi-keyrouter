{
  "name": "pi-keyrouter",
  "version": "1.3.0",
  "author": {
    "name": "jeryjs",
    "url": "https://github.com/jeryjs"
  },
  "contributors": [
    {
      "name": "lowern1ght",
      "url": "https://github.com/lowern1ght"
    }
  ],
  "description": "Credential pools for pi. Rotates API keys or stored OAuth logins inside providers you already have (built-in, models.json, or another extension's) on 429/401/403 and quota errors. Never registers its own provider; pi keeps auth, OAuth refresh and retries.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node test/fake-openai-server.mjs --selftest && node test/unit-oauth.mjs && node test/run.mjs",
    "test:e2e": "node test/run.mjs",
    "test:unit": "node test/unit-oauth.mjs",
    "test:probe": "node test/verify-runtime-credentials.mjs",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^25.9.1",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "index.ts",
    "config.ts",
    "oauth.ts",
    "rotation.ts",
    "notification.ts",
    "types.ts",
    "test/"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "api-key",
    "oauth",
    "key-rotation",
    "account-rotation",
    "credential-pool",
    "fallback",
    "ai-coding"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/jeryjs/pi-keyrouter#readme",
  "bugs": {
    "url": "https://github.com/jeryjs/pi-keyrouter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeryjs/pi-keyrouter.git",
    "directory": "packages/pi-keyrouter"
  }
}
