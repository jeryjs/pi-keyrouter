{
  "name": "pi-keyrouter",
  "version": "1.0.0",
  "description": "API key pools for pi. Rotates keys inside providers you already have (built-in, models.json, or another extension's) on 429/401/403. Never registers its own provider; pi keeps auth, OAuth and retries.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node test/fake-openai-server.mjs --selftest && node test/run.mjs",
    "test:e2e": "node test/run.mjs",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^25.9.1",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "files": [
    "README.md",
    "index.ts",
    "config.ts",
    "rotation.ts",
    "notification.ts",
    "types.ts",
    "test/"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "api-key",
    "key-rotation",
    "rate-limit",
    "fallback",
    "ai-coding"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/lowern1ght/pi-soly#readme",
  "bugs": {
    "url": "https://github.com/lowern1ght/pi-soly/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lowern1ght/pi-soly.git",
    "directory": "packages/pi-keyrouter"
  }
}
